# --- Go build artifacts ---
# Binaries
/aikata
/aikata.exe
*.exe
*.dll
*.so
*.dylib

# Test binaries / coverage
*.test
*.out
coverage.txt
coverage.html

# Go workspace files
go.work
go.work.sum

# Vendor (we use go modules, no vendor by default)
/vendor/

# --- Release artifacts ---
# Goreleaser writes build output (archives, checksums, snapshots) into
# ./dist/ by default. Ignore those, but keep the human-curated
# dist/ subdirectories that ship as release assets (Claude Code skill,
# future plugin payloads).
/dist/*
!/dist/README.md
!/dist/claude-code/
/bin/

# --- aikata-specific ---
# Proposals from `aikata init` against existing directories (do not commit)
/.aikata-proposed/

# NOTE: `.ai/` is intentionally NOT ignored here.
# aikata dogfoods itself; generated AI-tool artifacts (e.g. .ai/aikata.yaml, CLAUDE.md)
# are committed so that contributors can start working with Claude Code / Cursor
# immediately after `git clone`. See ARCHITECTURE.md §"Distribution & Generated Artifacts"
# and docs/adr/0003-do-no-harm-policy.md.

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Secrets ---
.env
.env.local
*.local

# --- Remember plugin (local-only memory) ---
/.remember/

# --- MCP server local state (per-developer, not part of aikata) ---
# Serena MCP writes project-local config / memories here when it activates
# against this repo from a developer's Claude Code environment. aikata
# itself has no dependency on Serena or any MCP server.
/.serena/
